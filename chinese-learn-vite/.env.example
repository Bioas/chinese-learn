# Supabase Configuration
# Create a free project at https://supabase.com
# Then copy your project URL and anon key below.
#
# 1. Go to https://app.supabase.com → New Project
# 2. Once created, go to Project Settings → API
# 3. Copy the "Project URL" as VITE_SUPABASE_URL
# 4. Copy the "anon public" key as VITE_SUPABASE_ANON_KEY
#
# After setting these, also run this SQL in Supabase SQL Editor
# to create the user_progress table:
#
#   CREATE TABLE user_progress (
#     user_id UUID PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE,
#     data JSONB NOT NULL DEFAULT '{}',
#     updated_at TIMESTAMPTZ DEFAULT NOW()
#   );
#
#   -- Allow users to CRUD their own row
#   ALTER TABLE user_progress ENABLE ROW LEVEL SECURITY;
#   CREATE POLICY "Users manage their own progress"
#     ON user_progress
#     FOR ALL
#     USING (auth.uid() = user_id)
#     WITH CHECK (auth.uid() = user_id);

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
