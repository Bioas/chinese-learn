# =============================================================================
# Supabase Configuration (cross-device sync)
# -----------------------------------------------------------------------------
# 1. Create a FREE project at https://supabase.com
# 2. Once created, go to  Project Settings → API
# 3. Copy the "Project URL"   → paste as VITE_SUPABASE_URL
# 4. Copy the "anon public"   → paste as VITE_SUPABASE_ANON_KEY
#
# 5. CRITICAL: open the SQL Editor in the Supabase dashboard and run the file
#    at:  supabase/migrations/00001_user_progress.sql
#    This creates the `user_progress` table, Row Level Security policies and
#    enables Realtime so other devices receive updates instantly.
#
# 6. (Optional) To enable Google sign-in:
#      Authentication → Providers → Google → enable and paste OAuth credentials
#    The redirect URL for local dev is:
#      http://localhost:5173
#    For production add your deployed URL too.
# =============================================================================

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
